<Window x:Class="DreamBit.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hosting="clr-namespace:DreamBit.Studio.Hosting"
        Title="DreamBit Studio (.NET 8 standalone)" Height="720" Width="1180"
        Background="{DynamicResource WindowBg}" TextElement.Foreground="{DynamicResource TextFg}" FontSize="12"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
        </Style>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
            <Setter Property="Margin" Value="10,8,0,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource AccentBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBg}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="3,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" Padding="6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Content="📁 Projeto" Click="OnOpenProject" ToolTip="Abre/cria um projeto (pasta com cenas)" />
                <Button Style="{StaticResource ToolButton}" Content="🧱 Conteúdo" Click="OnBuildContent" ToolTip="Gera Content.mgcb e compila com dotnet mgcb" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <Button Style="{StaticResource ToolButton}" Content="🗋 Nova" Click="OnNewScene" />
                <Button Style="{StaticResource ToolButton}" Content="📂 Abrir" Click="OnOpenScene" />
                <Button Style="{StaticResource ToolButton}" Content="💾 Salvar" Click="OnSaveScene" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <Button Style="{StaticResource ToolButton}" Content="↶ Desfazer" Command="{Binding UndoCommand}" ToolTip="Ctrl+Z" />
                <Button Style="{StaticResource ToolButton}" Content="↷ Refazer" Command="{Binding RedoCommand}" ToolTip="Ctrl+Y" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <Button Style="{StaticResource ToolButton}" Content="＋ Novo objeto" Command="{Binding AddObjectCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="↻ Rotator" Command="{Binding AddRotatorCommand}" ToolTip="Anexa um comportamento que gira o objeto no play" />
                <Button Style="{StaticResource ToolButton}" Content="🗺 TMX" Click="OnImportTmx" ToolTip="Importa um mapa Tiled (.tmx) como objeto" />
                <Button Style="{StaticResource ToolButton}" Content="🧩 Novo tilemap" Click="OnNewTilemap" ToolTip="Cria um tilemap em branco a partir de um tileset PNG (tiles 16px)" />
                <Button Style="{StaticResource ToolButton}" Content="🗑 Excluir" Command="{Binding DeleteObjectCommand}" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <Button Style="{StaticResource ToolButton}" Content="⭳ Prefab" Click="OnSavePrefab" ToolTip="Salvar o objeto selecionado como prefab" />
                <Button Style="{StaticResource ToolButton}" Content="⭱ Inserir" Click="OnInsertPrefab" ToolTip="Inserir um prefab na cena" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <Button x:Name="PlayButton" Style="{StaticResource ToolButton}" Content="▶ Play" Click="OnPlayToggle" />
                <Button Style="{StaticResource ToolButton}" Content="🎮 Rodar jogo" Click="OnRunGame" ToolTip="Abre a cena atual no DreamBit.Player" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <RadioButton GroupName="tool" Content="Selecionar" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" Margin="4,0"
                             IsChecked="{Binding IsSelectTool, Mode=OneWay}" Command="{Binding SelectToolCommand}" />
                <RadioButton GroupName="tool" Content="Ledge" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" Margin="4,0"
                             IsChecked="{Binding IsLedgeTool, Mode=OneWay}" Command="{Binding LedgeToolCommand}" />
                <RadioButton GroupName="tool" Content="Pincel" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" Margin="4,0"
                             IsChecked="{Binding IsTilemapTool, Mode=OneWay}" Command="{Binding TilemapToolCommand}"
                             ToolTip="Pintar tiles no tilemap selecionado" />
                <CheckBox Content="One-way" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" Margin="4,0"
                          IsChecked="{Binding NewLedgeOneWay}" ToolTip="One-way para novas ledges" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <CheckBox Content="Snap ao grid" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" Margin="4,0,0,0"
                          IsChecked="{Binding SnapToGrid}" />
                <Separator Width="1" Margin="8,2" Background="{DynamicResource BorderBg}" />
                <Button Style="{StaticResource ToolButton}" Content="🌓 Tema" Click="OnToggleTheme" ToolTip="Alterna claro/escuro" />
                <TextBlock Text="{Binding Camera.Zoom, StringFormat='Zoom: {0:0.00}x'}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource MutedFg}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="260" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!-- Cenas + Hierarquia + Assets -->
            <Grid Grid.Column="0" Background="{DynamicResource PanelBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="130" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Project.Title, StringFormat='CENAS · {0}'}" Style="{StaticResource PanelHeader}" />
                <ListBox Grid.Row="1" x:Name="ScenesList" Background="Transparent" BorderThickness="0" Margin="4"
                         ItemsSource="{Binding Project.Scenes}"
                         MouseDoubleClick="OnSceneDoubleClick"
                         ToolTip="Duplo clique abre a cena" />

                <StackPanel Grid.Row="2">
                    <TextBlock Text="HIERARQUIA" Style="{StaticResource PanelHeader}" />
                    <TextBox x:Name="HierarchySearch" Margin="6,0,6,4" Padding="3,2" TextChanged="OnHierarchySearchChanged"
                             ToolTip="Filtrar objetos por nome" />
                </StackPanel>
                <ListBox Grid.Row="3" x:Name="HierarchyList" Background="Transparent" BorderThickness="0" Margin="4"
                         ItemsSource="{Binding Scene.Objects}"
                         SelectionMode="Extended"
                         SelectionChanged="OnHierarchySelectionChanged"
                         DisplayMemberPath="Name" />

                <TextBlock Grid.Row="4" Text="ASSETS (imagens)" Style="{StaticResource PanelHeader}" />
                <ListBox Grid.Row="5" x:Name="AssetsList" Background="Transparent" BorderThickness="0" Margin="4"
                         ItemsSource="{Binding Project.Assets}"
                         MouseDoubleClick="OnAssetDoubleClick"
                         ToolTip="Duplo clique aplica a imagem ao sprite selecionado (ou cria um objeto)">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PathToFileName}}"
                                       Foreground="{DynamicResource TextFg}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBg}" />

            <!-- Editor de Cena (abas + canvas) -->
            <DockPanel Grid.Column="2">
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Background="{DynamicResource PanelBg}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2,3,0,0" CornerRadius="3,3,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource FieldBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentBg}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Title}" Click="OnActivateTab" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource TextFg}" Padding="8,3" />
                                    <Button Content="✕" Click="OnCloseTab" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource MutedFg}" Padding="4,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="PalettePanel" DockPanel.Dock="Bottom" Height="128"
                        Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBg}" BorderThickness="0,1,0,0"
                        Visibility="{Binding IsTilemapTool, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="PALETA — clique um tile (esquerdo pinta, direito apaga no canvas)"
                                   Style="{StaticResource PanelHeader}" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PaletteHost" Orientation="Horizontal" Margin="4" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBg}" BorderThickness="1">
                    <hosting:MonoGameSurface x:Name="Surface"
                                             MouseDown="Surface_MouseDown"
                                             MouseMove="Surface_MouseMove"
                                             MouseUp="Surface_MouseUp"
                                             MouseWheel="Surface_MouseWheel"
                                             MouseDoubleClick="Surface_DoubleClick"
                                             ClipToBounds="True" />
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBg}" />

            <!-- Inspetor -->
            <DockPanel Grid.Column="4" Background="{DynamicResource PanelBg}">
                <TextBlock DockPanel.Dock="Top" Text="INSPETOR" Style="{StaticResource PanelHeader}" />
                <StackPanel Margin="10,4">
                    <!-- Objeto selecionado -->
                    <StackPanel DataContext="{Binding Inspector}"
                                GotFocus="OnInspectorGotFocus" LostFocus="OnInspectorLostFocus"
                                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Nome" Foreground="{DynamicResource MutedFg}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Posição" Foreground="{DynamicResource MutedFg}" Margin="0,10,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding PositionX, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                            <TextBox Grid.Column="2" Text="{Binding PositionY, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                        </Grid>

                        <TextBlock Text="Rotação (graus)" Foreground="{DynamicResource MutedFg}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding RotationDegrees, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />

                        <TextBlock Text="Escala" Foreground="{DynamicResource MutedFg}" Margin="0,10,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ScaleX, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                            <TextBox Grid.Column="2" Text="{Binding ScaleY, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                        </Grid>

                        <TextBlock Text="COMPONENTES" Foreground="{DynamicResource MutedFg}" Margin="0,14,0,4" />

                        <!-- Sprite Renderer -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,2" CornerRadius="3"
                                Visibility="{Binding HasSprite, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveSprite"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Sprite Renderer" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Tamanho (L × A)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SpriteWidth, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                                    <TextBox Grid.Column="2" Text="{Binding SpriteHeight, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                                </Grid>
                                <TextBlock Text="Cor (R G B)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SpriteR, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="2" Text="{Binding SpriteG, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="4" Text="{Binding SpriteB, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <TextBlock Text="Textura (PNG)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding SpriteTexturePath}" IsReadOnly="True" TextWrapping="NoWrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Content="Escolher…" Click="OnPickTexture" Style="{StaticResource ToolButton}" />
                                    <Button Content="Limpar" Click="OnClearTexture" Style="{StaticResource ToolButton}"
                                            Visibility="{Binding SpriteHasTexture, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="+ Sprite Renderer" Click="OnAddSprite" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasSprite, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Sprite Animator -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasAnimator, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveAnimator"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Sprite Animator" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Sprite sheet (PNG)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding AnimTexturePath}" IsReadOnly="True" />
                                <Button Content="Escolher…" Click="OnPickAnimTexture" Style="{StaticResource ToolButton}"
                                        HorizontalAlignment="Left" Margin="0,2" />
                                <TextBlock Text="Frame (L × A)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding AnimFrameWidth, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="2" Text="{Binding AnimFrameHeight, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <TextBlock Text="Nº de frames / FPS" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding AnimFrameCount, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="2" Text="{Binding AnimFps, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                                </Grid>
                                <CheckBox Content="Repetir (loop)" Margin="0,6,0,0" Foreground="{DynamicResource TextFg}"
                                          IsChecked="{Binding AnimLoop}" />
                            </StackPanel>
                        </Border>
                        <Button Content="+ Sprite Animator" Click="OnAddAnimator" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasAnimator, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Rotator -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasRotator, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveRotator"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Rotator" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Velocidade (rad/s)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding RotatorSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.###}" />
                            </StackPanel>
                        </Border>
                        <Button Content="+ Rotator" Click="OnAddRotator" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasRotator, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Platformer Controller -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasPlatformer, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemovePlatformer"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Platformer (cai nas ledges)" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Gravidade" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding PlatGravity, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                <TextBlock Text="Meia-altura (pés)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding PlatHalfHeight, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                <CheckBox Content="Controlar por teclado (setas/A-D, Espaço pula)" Margin="0,8,0,0"
                                          Foreground="{DynamicResource TextFg}" IsChecked="{Binding PlatUseKeyboard}" />
                                <StackPanel Visibility="{Binding PlatUseKeyboard, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Velocidade / Pulo" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding PlatMoveSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                        <TextBox Grid.Column="2" Text="{Binding PlatJumpSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding PlatUseKeyboard, Converter={StaticResource BoolToVisInverse}}">
                                    <TextBlock Text="Velocidade horizontal" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                    <TextBox Text="{Binding PlatHorizontalSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="+ Platformer" Click="OnAddPlatformer" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasPlatformer, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Audio Source -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveAudio"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Audio Source" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Som (WAV)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding AudioPath}" IsReadOnly="True" />
                                <Button Content="Escolher…" Click="OnPickSound" Style="{StaticResource ToolButton}"
                                        HorizontalAlignment="Left" Margin="0,2" />
                                <TextBlock Text="Volume (0–1)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding AudioVolume, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" />
                                <CheckBox Content="Tocar ao iniciar" Margin="0,6,0,0" Foreground="{DynamicResource TextFg}"
                                          IsChecked="{Binding AudioPlayOnStart}" />
                                <CheckBox Content="Repetir (loop)" Margin="0,4,0,0" Foreground="{DynamicResource TextFg}"
                                          IsChecked="{Binding AudioLoop}" />
                            </StackPanel>
                        </Border>
                        <Button Content="+ Audio Source" Click="OnAddAudio" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasAudio, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Particle Emitter -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasParticles, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveParticles"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Particle Emitter (no play)" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Taxa / Vida" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ParticleRate, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                    <TextBox Grid.Column="2" Text="{Binding ParticleLifetime, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                                </Grid>
                                <TextBlock Text="Velocidade / Tamanho / Gravidade" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ParticleSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                    <TextBox Grid.Column="2" Text="{Binding ParticleSize, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                    <TextBox Grid.Column="4" Text="{Binding ParticleGravity, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                </Grid>
                                <TextBlock Text="Cor (R G B)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ParticleR, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="2" Text="{Binding ParticleG, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="4" Text="{Binding ParticleB, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="+ Particle Emitter" Click="OnAddParticles" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasParticles, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Follow Target -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasFollow, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveFollow"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Follow Target" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Alvo" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <ComboBox Margin="0,2"
                                          ItemsSource="{Binding DataContext.Scene.Objects, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding FollowTargetObject, Mode=TwoWay}"
                                          DisplayMemberPath="Name" />
                                <TextBlock Text="Rapidez" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding FollowSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                            </StackPanel>
                        </Border>
                        <Button Content="+ Follow Target" Click="OnAddFollow" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasFollow, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Trigger Zone -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasTrigger, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveTrigger"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Trigger Zone (coletável)" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Tamanho (L × A)" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding TriggerWidth, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                    <TextBox Grid.Column="2" Text="{Binding TriggerHeight, UpdateSourceTrigger=LostFocus, StringFormat=0.#}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Button Content="+ Trigger Zone" Click="OnAddTrigger" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0,2"
                                Visibility="{Binding HasTrigger, Converter={StaticResource BoolToVisInverse}}" />

                        <!-- Tilemap -->
                        <Border Background="{DynamicResource FieldBg}" Padding="6" Margin="0,4,0,2" CornerRadius="3"
                                Visibility="{Binding HasTilemap, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,0" Click="OnRemoveTilemap"
                                            Style="{StaticResource ToolButton}" />
                                    <TextBlock Text="Tilemap (Tiled)" Foreground="{DynamicResource TextFg}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="Arquivo .tmx" Foreground="{DynamicResource MutedFg}" Margin="0,6,0,0" />
                                <TextBox Text="{Binding TilemapPath}" IsReadOnly="True" />
                                <Button Content="Trocar…" Click="OnChangeTmx" Style="{StaticResource ToolButton}"
                                        HorizontalAlignment="Left" Margin="0,2" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Ledge selecionada -->
                    <StackPanel Visibility="{Binding HasSelectedLedge, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="LEDGE (borda caminhável)" Foreground="{DynamicResource MutedFg}" />
                        <TextBox Text="{Binding SelectedLedge.Name, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="One-way (atravessa por baixo)" Margin="0,8,0,0"
                                  Foreground="{DynamicResource TextFg}" IsChecked="{Binding SelectedLedge.OneWay}" />
                        <TextBlock Text="{Binding SelectedLedge.Points.Count, StringFormat='Pontos: {0}'}"
                                   Foreground="{DynamicResource MutedFg}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Dica da ferramenta Ledge -->
                    <TextBlock Visibility="{Binding IsLedgeTool, Converter={StaticResource BoolToVis}}"
                               Foreground="{DynamicResource MutedFg}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Ferramenta Ledge: clique para adicionar pontos; botão direito, Enter ou duplo clique finaliza; Esc cancela." />
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
