<Window x:Class="DreamBit.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hosting="clr-namespace:DreamBit.Studio.Hosting"
        Title="DreamBit Studio (.NET 8 standalone)" Height="720" Width="1180"
        Background="#1E2128" TextElement.Foreground="#D6DBE6" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D6DBE6" />
        </Style>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A6" />
            <Setter Property="Margin" Value="10,8,0,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#2F3440" />
            <Setter Property="Foreground" Value="#EAEEF6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2E38" />
            <Setter Property="Foreground" Value="#EAEEF6" />
            <Setter Property="BorderBrush" Value="#3A404C" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="3,2" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#252932" Padding="6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Content="🗋 Nova" Click="OnNewScene" />
                <Button Style="{StaticResource ToolButton}" Content="📂 Abrir" Click="OnOpenScene" />
                <Button Style="{StaticResource ToolButton}" Content="💾 Salvar" Click="OnSaveScene" />
                <Separator Width="1" Margin="8,2" Background="#3A404C" />
                <Button Style="{StaticResource ToolButton}" Content="＋ Novo objeto" Command="{Binding AddObjectCommand}" />
                <Button Style="{StaticResource ToolButton}" Content="↻ Rotator" Command="{Binding AddRotatorCommand}" ToolTip="Anexa um comportamento que gira o objeto no play" />
                <Button Style="{StaticResource ToolButton}" Content="🗑 Excluir" Command="{Binding DeleteObjectCommand}" />
                <Separator Width="1" Margin="8,2" Background="#3A404C" />
                <Button x:Name="PlayButton" Style="{StaticResource ToolButton}" Content="▶ Play" Click="OnPlayToggle" />
                <TextBlock Text="{Binding Camera.Zoom, StringFormat='Zoom: {0:0.00}x'}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#8A93A6" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="260" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <!-- Hierarquia -->
            <DockPanel Grid.Column="0" Background="#252932">
                <TextBlock DockPanel.Dock="Top" Text="HIERARQUIA" Style="{StaticResource PanelHeader}" />
                <ListBox x:Name="HierarchyList" Background="Transparent" BorderThickness="0" Margin="4"
                         ItemsSource="{Binding Scene.Objects}"
                         SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                         DisplayMemberPath="Name" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#11141A" />

            <!-- Editor de Cena -->
            <Border Grid.Column="2" BorderBrush="#11141A" BorderThickness="1">
                <hosting:MonoGameSurface x:Name="Surface"
                                         MouseDown="Surface_MouseDown"
                                         MouseMove="Surface_MouseMove"
                                         MouseUp="Surface_MouseUp"
                                         MouseWheel="Surface_MouseWheel"
                                         ClipToBounds="True" />
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#11141A" />

            <!-- Inspetor -->
            <DockPanel Grid.Column="4" Background="#252932">
                <TextBlock DockPanel.Dock="Top" Text="INSPETOR" Style="{StaticResource PanelHeader}" />
                <StackPanel Margin="10,4" DataContext="{Binding Inspector}"
                            Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nome" Foreground="#8A93A6" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Posição" Foreground="#8A93A6" Margin="0,10,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PositionX, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                        <TextBox Grid.Column="2" Text="{Binding PositionY, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                    </Grid>

                    <TextBlock Text="Rotação (graus)" Foreground="#8A93A6" Margin="0,10,0,0" />
                    <TextBox Text="{Binding RotationDegrees, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />

                    <TextBlock Text="Escala" Foreground="#8A93A6" Margin="0,10,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ScaleX, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                        <TextBox Grid.Column="2" Text="{Binding ScaleY, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
