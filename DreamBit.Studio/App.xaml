<Application x:Class="DreamBit.Studio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DreamBit.Studio.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="BoolToVisInverse" />
        <conv:PathToFileNameConverter x:Key="PathToFileName" />

        <!-- Estilos reutilizáveis do editor -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
        </Style>
        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedFg}" />
            <Setter Property="Margin" Value="10,8,0,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource AccentBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBg}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBg}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="3,2" />
        </Style>

        <!-- Cores do tema (valores iniciais = escuro; trocados em runtime pelo ThemeManager) -->
        <SolidColorBrush x:Key="WindowBg" Color="#1E2128" />
        <SolidColorBrush x:Key="PanelBg" Color="#252932" />
        <SolidColorBrush x:Key="FieldBg" Color="#2A2E38" />
        <SolidColorBrush x:Key="TextFg" Color="#D6DBE6" />
        <SolidColorBrush x:Key="MutedFg" Color="#8A93A6" />
        <SolidColorBrush x:Key="BorderBg" Color="#11141A" />
        <SolidColorBrush x:Key="AccentBg" Color="#2F3440" />
    </Application.Resources>
</Application>
